{
  "name": "s-shot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Full-page screenshot Chrome extension: capture any web page or PDF as one crisp, print-ready PNG.",
  "author": "Skye Wigley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyewigley/S-Shot.git"
  },
  "homepage": "https://github.com/skyewigley/S-Shot#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tailwindcss -i src/styles/tailwind.input.css -o src/styles/tailwind.css --watch",
    "build:css": "tailwindcss -i src/styles/tailwind.input.css -o src/styles/tailwind.css --minify",
    "build": "npm run build:css && node scripts/package-extension.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "version": "node scripts/sync-manifest-version.mjs && git add manifest.json"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
